menu "FDict One OTA"

    config FD_OTA_LAB
        bool "LAB: may chu dict Lab/dev (chi build thu, KHONG phat hanh)"
        default n
        help
            Khong con chon server (giu cho tuong thich sdkconfig). Server chon luc chay theo Che do nha phat trien:
            bat = FD_OTA_LAB_BASE_URL (Lab/dev, mac dinh https + cert bundle), tat = FD_OTA_BASE_URL (https + cert bundle, khong tat kiem cert). Van cho phep http:// khi Lab neu URL Lab la http.

    config FD_OTA_LAB_BASE_URL
        string "LAB base URL (https uu tien, khong co /api; van chap nhan http LAN)"
        default "https://fdict-dev.joinnow.vn"

    config FD_OTA_BASE_URL
        string "Production base URL (https, khong co /api)"
        default "https://your-server.example"
        help
            Endpoint: {base}/api/ota/check, {base}/api/ota/report, {base}/api/devices/pair/start|poll.

    config FD_PAIR_LAB_WEB_URL
        string "LAB: trang ghep tren web (QR, them ?id=&hw=&fw=&b=)"
        default "https://fdict-dev.joinnow.vn/pairing-device"

    config FD_PAIR_WEB_URL
        string "Production: trang ghep tren web (QR, them ?code=<ma>)"
        default "https://your-server.example/pairing-device"

    config FD_OTA_HW
        string "Ma phan cung (hw)"
        default "fnk0104b"

    config FD_OTA_CHECK_INTERVAL_S
        int "Chu ky kiem tra mac dinh (giay)"
        range 3600 172800
        default 43200
        help
            Dung khi may chu khong tra check_again_s. check_again_s duoc kep 1 h..48 h, +-10% ngau nhien.

endmenu
