# FDict One - cau hinh rieng ESP32-S3 N16R8 (16MB flash QSPI, 8MB PSRAM octal)

# --- Flash ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# QIO: module N16R8 ho tro. Neu boot loi (bootloop "invalid header") -> doi sang CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- PSRAM octal ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
# Thu nghiem: buffer WiFi/LWIP o RAM noi (nghi gay loi auth reason 2)
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=n
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# --- Cache (toi uu cho LVGL + PSRAM) ---
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
